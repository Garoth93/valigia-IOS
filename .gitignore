# Xcode project is generated by XcodeGen: never commit it
*.xcodeproj
*.xcworkspace
!*.xcodeproj/project.xcworkspace

# Build output
.build/
build/
DerivedData/
*.ipa
*.xcarchive
*.dSYM.zip

# Swift Package Manager
Package.resolved
.swiftpm/

# macOS / editor
.DS_Store
*.xcuserstate
xcuserdata/
*.swp

# Signing material must never be committed
*.p12
*.mobileprovision
*.p8
*.cer
*.certSigningRequest
AuthKey_*.p8

# Info.plist files are generated by XcodeGen from project.yml
apps/*/Info.plist
apps/*/*-Info.plist

# PERSONAL DATA — never commit packing lists, backups or photos.
# Tests use synthetic data generated in code only.
/data/
/private/
/personal/
/exports/
*.zip
valigia-backup*.json
valigia-data*.json
Valigia-backup*.json
*.json.bak
*.csv
*.heic
*.HEIC
/photos/
